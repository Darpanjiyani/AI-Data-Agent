# Copy this file to .env and fill in your own values.
# Never commit .env or share it.

# Anthropic
ANTHROPIC_API_KEY=Enter your Anthropic API key here

# Database connection used by the AI agent
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ride_share

# Read-only user: the agent connects with this user for every query
DB_READER_USER=agent_reader
DB_READER_PASSWORD=Enter your read-only password here

# Admin user: only used by utils/feed_db.py to create tables and load data
host=localhost
port=5432
database=ride_share
user=postgres
password=Enter your admin password here
