# Copy this file to .env and fill in your own values.
# Never commit .env or share it.

# Anthropic
ANTHROPIC_API_KEY=

# Database connection used by the AI agent
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ride_share

# Read-only user: the agent connects with this user for every query
DB_READER_USER=agent_reader
DB_READER_PASSWORD=

# Writer user: only used when a person approves a load (EXP-13). It can write only to the
# "external" schema. Create it once with: uv run python utils/setup_load_access.py
DB_WRITER_USER=etl_writer
DB_WRITER_PASSWORD=

# Admin user: only used by utils/feed_db.py and utils/setup_load_access.py (setup)
host=localhost
port=5432
database=ride_share
user=postgres
password=
